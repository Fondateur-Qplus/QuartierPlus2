NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://quartierplus:change-me@localhost:5432/quartierplus
JWT_SECRET=replace-with-at-least-32-random-characters
# Use a stable random 32+ character key; changing it invalidates issued ticket QR signatures.
TICKET_QR_SECRET=replace-with-a-separate-random-ticket-signing-secret
JWT_EXPIRES_IN=7d
# Set to true to grant authenticated users free event creation and Pro dashboard access.
IS_PROMO_FREE_ACCESS=false
BILLING_ENABLED=false
GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Optional comma-separated additional OAuth client IDs for iOS and Android.
GOOGLE_CLIENT_IDS=
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
FEDAPAY_SECRET_KEY=replace-with-fake-fedapay-secret-key
FEDAPAY_PUBLIC_KEY=replace-with-fake-fedapay-public-key
FEDAPAY_ENVIRONMENT=sandbox
# Configure this as the X-FedaPay-Webhook-Secret custom header in FedaPay.
FEDAPAY_WEBHOOK_SECRET=replace-with-fake-webhook-secret
PGSSL=false

# Signed Cloudinary uploads; these values are server-only and must never go in the mobile app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Media publishing limits can be changed without a new app build.
POST_MAX_PHOTO_BYTES=10485760
POST_MAX_VIDEO_SECONDS=30
POST_MAX_VIDEO_BYTES=31457280
POST_DAILY_LIMIT=10

# Enable only for local development/testing; fixed 123456 is restricted to this allowlist.
OTP_TEST_MODE=false
OTP_TEST_ALLOWLIST=
# Production SMS gateway contract: POST JSON { "to": "+...", "message": "..." }.
SMS_DELIVERY_URL=
SMS_DELIVERY_TOKEN=

# Comma-separated web origins allowed to open Socket.IO polling connections.
SOCKET_CORS_ORIGIN=
